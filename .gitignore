/target/
*.profraw

# Documentation site build artifacts.
# No trailing slash: a symlinked checkout (as in a worktree) must match too.
node_modules
docs/.vitepress/dist/
docs/.vitepress/cache/
# Assembled from every crate's CHANGELOG.md by `cargo run -p xtask -- docs`
# (also under --check, before the site build). Committing it made every pair
# of open pull requests conflict on its [Unreleased] section.
/docs/project/changelog.md

# Local read-only reference checkouts (upstream schemas, competitor sources).
# Never redistributable, never a build dependency -- see AGENTS.md.
# Ignored so check-leakage.py sees only the publishable tree.
/references

# Local-only cargo config: redirects kernel pins to a local checkout
# during upstream development. Never committed.
.cargo/

# wasm-bindgen output of crates/openbim-ifc-wasm/scripts/build-npm-pkg.sh
crates/openbim-ifc-wasm/pkg/

# Python bytecode (openbim-ifc-py)
__pycache__/
*.pyc
