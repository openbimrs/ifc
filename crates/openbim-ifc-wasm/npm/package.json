{
  "name": "@openbim/ifc",
  "description": "Read, edit and write IFC STEP files from JavaScript (WebAssembly build of openbim-ifc).",
  "version": "0.4.1",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openbimrs/ifc.git",
    "directory": "crates/openbim-ifc-wasm"
  },
  "type": "commonjs",
  "main": "openbim_ifc_wasm.js",
  "types": "openbim_ifc_wasm.d.ts",
  "exports": {
    ".": {
      "node": {
        "types": "./openbim_ifc_wasm.d.ts",
        "default": "./openbim_ifc_wasm.js"
      },
      "default": {
        "types": "./bundler/openbim_ifc_wasm.d.ts",
        "default": "./bundler/openbim_ifc_wasm.js"
      }
    },
    "./bundler": {
      "types": "./bundler/openbim_ifc_wasm.d.ts",
      "default": "./bundler/openbim_ifc_wasm.js"
    },
    "./web": {
      "types": "./web/openbim_ifc_wasm.d.ts",
      "default": "./web/openbim_ifc_wasm.js"
    },
    "./mesh": {
      "node": {
        "types": "./mesh/openbim_ifc_wasm.d.ts",
        "default": "./mesh/openbim_ifc_wasm.js"
      },
      "default": {
        "types": "./mesh/bundler/openbim_ifc_wasm.d.ts",
        "default": "./mesh/bundler/openbim_ifc_wasm.js"
      }
    },
    "./mesh/bundler": {
      "types": "./mesh/bundler/openbim_ifc_wasm.d.ts",
      "default": "./mesh/bundler/openbim_ifc_wasm.js"
    },
    "./mesh/web": {
      "types": "./mesh/web/openbim_ifc_wasm.d.ts",
      "default": "./mesh/web/openbim_ifc_wasm.js"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "files": [
    "openbim_ifc_wasm.js",
    "openbim_ifc_wasm.d.ts",
    "openbim_ifc_wasm_bg.wasm",
    "openbim_ifc_wasm_bg.wasm.d.ts",
    "bundler/",
    "web/",
    "mesh/",
    "catalog/",
    "catalog.mjs",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": ["ifc", "bim", "openbim", "step", "wasm"]
}
