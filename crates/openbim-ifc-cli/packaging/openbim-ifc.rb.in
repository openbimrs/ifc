# Homebrew formula for the openbim-ifc command (openbim-ifc-cli @VERSION@).
#
# Generated by crates/openbim-ifc-cli/scripts/package.py from the
# SHA256SUMS of the openbim-ifc-cli-v@VERSION@ GitHub release of
# openbimrs/ifc; edit packaging/openbim-ifc.rb.in there, not this file.
class OpenbimIfc < Formula
  desc "Validate, convert and inspect IFC files (STEP and ifcXML)"
  homepage "https://openbimrs.github.io/ifc/guide/cli"
  version "@VERSION@"
  license "AGPL-3.0-or-later"

  on_macos do
    on_arm do
      url "https://github.com/openbimrs/ifc/releases/download/openbim-ifc-cli-v@VERSION@/openbim-ifc-v@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA256:aarch64-apple-darwin@"
    end
    on_intel do
      url "https://github.com/openbimrs/ifc/releases/download/openbim-ifc-cli-v@VERSION@/openbim-ifc-v@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA256:x86_64-apple-darwin@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/openbimrs/ifc/releases/download/openbim-ifc-cli-v@VERSION@/openbim-ifc-v@VERSION@-aarch64-unknown-linux-musl.tar.gz"
      sha256 "@SHA256:aarch64-unknown-linux-musl@"
    end
    on_intel do
      url "https://github.com/openbimrs/ifc/releases/download/openbim-ifc-cli-v@VERSION@/openbim-ifc-v@VERSION@-x86_64-unknown-linux-musl.tar.gz"
      sha256 "@SHA256:x86_64-unknown-linux-musl@"
    end
  end

  def install
    bin.install "openbim-ifc"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/openbim-ifc --version")
    (testpath/"empty.ifc").write "not an IFC file"
    assert_match "parse", shell_output("#{bin}/openbim-ifc info #{testpath}/empty.ifc 2>&1", 2)
  end
end
