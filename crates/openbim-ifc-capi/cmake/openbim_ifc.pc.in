# openbim_ifc @OPENBIM_IFC_VERSION@, shared library (#325). Generated by
# crates/openbim-ifc-capi/CMakeLists.txt; openbim_ifc-static.pc is the static
# variant. Paths are relative to this file, so an installed tree or an
# unpacked release archive can live anywhere.
prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: openbim_ifc
Description: openbim-ifc C ABI: read, edit and write IFC STEP files (shared library)
URL: https://github.com/openbimrs/ifc
Version: @OPENBIM_IFC_VERSION@
Cflags: -I${includedir}
Libs: -L${libdir} -lopenbim_ifc_capi
