# openbim_ifc @OPENBIM_IFC_VERSION@, static library (#325). Generated by
# crates/openbim-ifc-capi/CMakeLists.txt; openbim_ifc.pc is the shared
# variant. Paths are relative to this file, so an installed tree or an
# unpacked release archive can live anywhere.
#
# The archive is named by path, not -l: lib/ holds the shared library under
# the same name, and a linker given -lopenbim_ifc_capi prefers that one. The
# system libraries after it are those Rust's standard library needs, the same
# list the CMake target openbim_ifc::openbim_ifc_static carries.
prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: openbim_ifc-static
Description: openbim-ifc C ABI: read, edit and write IFC STEP files (static library)
URL: https://github.com/openbimrs/ifc
Version: @OPENBIM_IFC_VERSION@
Cflags: -I${includedir}
Libs: ${libdir}/@OPENBIM_IFC_STATIC_FILE@ @OPENBIM_IFC_PC_STATIC_LIBS@
