# openbim_ifc @OPENBIM_IFC_VERSION@: the openbim-ifc C ABI as a CMake package (#41).
#
#   find_package(openbim_ifc @OPENBIM_IFC_VERSION_MAJOR@.@OPENBIM_IFC_VERSION_MINOR@ CONFIG REQUIRED)
#   target_link_libraries(app PRIVATE openbim_ifc::openbim_ifc)
#
# openbim_ifc::openbim_ifc is the shared library unless OPENBIM_IFC_LINKAGE is
# STATIC before find_package; openbim_ifc::openbim_ifc_shared and
# openbim_ifc::openbim_ifc_static name one variant explicitly. Generated by
# crates/openbim-ifc-capi/CMakeLists.txt; paths are relative to this file, so
# an installed tree or an unpacked release archive can live anywhere.
get_filename_component(_openbim_ifc_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)

if(NOT DEFINED OPENBIM_IFC_LINKAGE)
  set(OPENBIM_IFC_LINKAGE "SHARED")
endif()
string(TOUPPER "${OPENBIM_IFC_LINKAGE}" _openbim_ifc_linkage)
if(NOT _openbim_ifc_linkage MATCHES "^(SHARED|STATIC)$")
  set(openbim_ifc_FOUND FALSE)
  set(openbim_ifc_NOT_FOUND_MESSAGE "OPENBIM_IFC_LINKAGE must be SHARED or STATIC, not ${OPENBIM_IFC_LINKAGE}")
  return()
endif()
if(NOT CMAKE_SYSTEM_NAME STREQUAL "@OPENBIM_IFC_SYSTEM_NAME@")
  set(openbim_ifc_FOUND FALSE)
  set(openbim_ifc_NOT_FOUND_MESSAGE "this openbim_ifc package is built for @OPENBIM_IFC_SYSTEM_NAME@, not ${CMAKE_SYSTEM_NAME}")
  return()
endif()
if(NOT CMAKE_SYSTEM_PROCESSOR MATCHES "@OPENBIM_IFC_PROCESSOR_REGEX@")
  set(openbim_ifc_FOUND FALSE)
  set(openbim_ifc_NOT_FOUND_MESSAGE "this openbim_ifc package does not support processor ${CMAKE_SYSTEM_PROCESSOR}")
  return()
endif()

# A second find_package in the same directory scope must not redefine them.
if(NOT TARGET openbim_ifc::openbim_ifc_shared)
  add_library(openbim_ifc::openbim_ifc_shared SHARED IMPORTED)
  if(WIN32)
    set_target_properties(openbim_ifc::openbim_ifc_shared PROPERTIES
      IMPORTED_LOCATION "${_openbim_ifc_prefix}/bin/@OPENBIM_IFC_SHARED_FILE@"
      IMPORTED_IMPLIB "${_openbim_ifc_prefix}/lib/@OPENBIM_IFC_IMPLIB_FILE@")
  else()
    # On macOS the install name is @rpath/@OPENBIM_IFC_SHARED_FILE@; CMake gives
    # the consumer's build tree an LC_RPATH to this existing file's directory.
    # An installed consumer sets its own INSTALL_RPATH, as for any dylib.
    set_target_properties(openbim_ifc::openbim_ifc_shared PROPERTIES
      IMPORTED_LOCATION "${_openbim_ifc_prefix}/lib/@OPENBIM_IFC_SHARED_FILE@"
      IMPORTED_SONAME "@OPENBIM_IFC_SHARED_SONAME@")
  endif()
  set_target_properties(openbim_ifc::openbim_ifc_shared PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${_openbim_ifc_prefix}/include")

  add_library(openbim_ifc::openbim_ifc_static STATIC IMPORTED)
  set_target_properties(openbim_ifc::openbim_ifc_static PROPERTIES
    IMPORTED_LOCATION "${_openbim_ifc_prefix}/lib/@OPENBIM_IFC_STATIC_FILE@"
    INTERFACE_INCLUDE_DIRECTORIES "${_openbim_ifc_prefix}/include"
    INTERFACE_LINK_LIBRARIES "@OPENBIM_IFC_STATIC_DEPS@")
endif()

if(NOT TARGET openbim_ifc::openbim_ifc)
  add_library(openbim_ifc::openbim_ifc INTERFACE IMPORTED)
  if(_openbim_ifc_linkage STREQUAL "STATIC")
    set_property(TARGET openbim_ifc::openbim_ifc PROPERTY INTERFACE_LINK_LIBRARIES openbim_ifc::openbim_ifc_static)
  else()
    set_property(TARGET openbim_ifc::openbim_ifc PROPERTY INTERFACE_LINK_LIBRARIES openbim_ifc::openbim_ifc_shared)
  endif()
endif()

set(openbim_ifc_INCLUDE_DIR "${_openbim_ifc_prefix}/include")
unset(_openbim_ifc_prefix)
unset(_openbim_ifc_linkage)
