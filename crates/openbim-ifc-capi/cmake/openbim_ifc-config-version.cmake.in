# openbim_ifc @OPENBIM_IFC_VERSION@. Below 1.0 the minor version is the breaking
# axis (as in Cargo), so a request for 0.1 accepts 0.1.x at or above it and
# nothing from 0.2; from 1.0 on, the major version.
set(PACKAGE_VERSION "@OPENBIM_IFC_VERSION@")
set(PACKAGE_VERSION_COMPATIBLE FALSE)
if(NOT PACKAGE_FIND_VERSION VERSION_GREATER PACKAGE_VERSION
   AND PACKAGE_FIND_VERSION_MAJOR EQUAL @OPENBIM_IFC_VERSION_MAJOR@)
  if(@OPENBIM_IFC_VERSION_MAJOR@ GREATER 0 OR PACKAGE_FIND_VERSION_MINOR EQUAL @OPENBIM_IFC_VERSION_MINOR@)
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
  endif()
endif()
if(PACKAGE_FIND_VERSION VERSION_EQUAL PACKAGE_VERSION)
  set(PACKAGE_VERSION_EXACT TRUE)
endif()
# Built for one pointer width only.
if(NOT "${CMAKE_SIZEOF_VOID_P}" STREQUAL "" AND NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
  set(PACKAGE_VERSION "${PACKAGE_VERSION} (64-bit)")
  set(PACKAGE_VERSION_UNSUITABLE TRUE)
endif()
