<Project Sdk="Microsoft.NET.Sdk">

  <!-- The OpenBim.Ifc NuGet package (#327): P/Invoke over the versioned C ABI
       of openbim-ifc-capi. `Version` must equal the crate version in
       ../../Cargo.toml; scripts/release-crate.py bumps both, and the release
       plan refuses a tag where they differ. -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <RootNamespace>OpenBim.Ifc</RootNamespace>
    <AssemblyName>OpenBim.Ifc</AssemblyName>

    <PackageId>OpenBim.Ifc</PackageId>
    <Version>0.1.3</Version>
    <Authors>point-grey</Authors>
    <Description>Read, edit, validate and write IFC (STEP and ifcXML) files from .NET: the openbim-ifc Rust core over its versioned C ABI, with property sets, the spatial tree, materials, classification, systems, cost and georeferencing.</Description>
    <PackageTags>ifc;bim;openbim;step;ifcxml;buildingsmart</PackageTags>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>https://openbimrs.github.io/ifc/bindings/dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/openbimrs/ifc</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>false</IncludeSymbols>

    <!-- The native libraries, one directory per runtime identifier, each
         holding the C ABI's shared library: <NativeDir>/<rid>/<file>.
         scripts/check-dotnet.py stages it from a local build or from the
         release archives. -->
    <NativeDir Condition="'$(NativeDir)' == ''">$(MSBuildThisFileDirectory)../artifacts/native</NativeDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../../../NOTICE" Pack="true" PackagePath="/" />
    <!-- .NET Framework consumers (Revit, Navisworks, ...) get no native
         assets from runtimes/ unless they name a RuntimeIdentifier; these
         targets copy the Windows libraries next to the assembly. -->
    <None Include="build/OpenBim.Ifc.targets" Pack="true" PackagePath="build/net462/;buildTransitive/net462/" />
    <None Include="$(NativeDir)/**/*" Pack="true" PackagePath="runtimes/%(RecursiveDir)native/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
